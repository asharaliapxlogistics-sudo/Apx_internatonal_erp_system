# Project MySQL (mysql/my.ini, port 3307). Start it with start-mysql.cmd
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=apx_erp
DB_USER=apx_erp
DB_PASSWORD=

# Frontend address allowed to call the API
CORS_ORIGINS=http://localhost:5190

# Signs login tokens. Long random value; a different one on Railway. Changing it logs everyone out.
JWT_SECRET=
